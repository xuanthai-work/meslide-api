# Copy this file to .env (Compose reads .env next to docker-compose.yml):
#   copy .env.example .env
#
# Start this API, then start gslide-web on the same Docker network `gslide`:
#   docker compose up --build api
# Dev with hot-reload:
#   docker compose up --build api-dev
#
# Direct API: http://localhost:8000
# Browser UI comes from gslide-web at http://localhost:3000
# After changing .env, recreate the container:
#   docker compose up --build --force-recreate api

# =============================================================================
# Minimal setup (enough to generate slides)
# =============================================================================

# Host port for FastAPI (default 8000). The browser stays same-origin against
# the web service; this is only for direct access / debugging.
GSLIDE_API_HOST_PORT=8000

# Chromium (in this container) renders exports through the web service.
EXPORT_PAGE_BASE_URL=http://web:3000

# openai | google | custom
LLM=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# Optional: seed a user on first boot. Leave both blank to force the first
# visitor to register at /. Password must be at least 8 characters.
# AUTH_USERNAME=alice
# AUTH_PASSWORD=change-this-password

# Default Mem0 target is OpenAI. Disable unless OPENAI_API_KEY is set (or MEM0_LLM_* overridden).
MEM0_ENABLED=false

# Optional: skip slide images until an IMAGE_PROVIDER is configured.
DISABLE_IMAGE_GENERATION=true

# =============================================================================
# Docker / runtime
# =============================================================================

# linux/amd64 (default) | linux/arm64
# GSLIDE_DOCKER_PLATFORM=linux/amd64

# Leave empty to use SQLite under the shared gslide_app_data volume.
# DATABASE_URL=postgresql://gslide:password@postgres:5432/gslide

# =============================================================================
# Object storage (S3 / MinIO)
# =============================================================================
# Default backend stays `local` (files under /app_data). Point these at an
# existing S3-compatible endpoint when you need object storage; this repo does
# not ship MinIO.
OBJECT_STORAGE_BACKEND=local

# S3_ENDPOINT_URL=
S3_ACCESS_KEY=gslide-minio
S3_SECRET_KEY=gslide-minio-dev-secret
S3_BUCKET=gslide
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=30

# =============================================================================
# Auth (optional extras)
# =============================================================================

# DISABLE_AUTH=false
# AUTH_OVERRIDE_FROM_ENV=true
# RESET_AUTH=true

# =============================================================================
# LLM providers — fill only the one matching LLM=
# =============================================================================

# --- OpenAI ---
# LLM=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# --- Google Gemini ---
# LLM=google
# GOOGLE_API_KEY=
# GOOGLE_MODEL=models/gemini-2.0-flash

# --- OpenAI-compatible (vLLM, LiteLLM proxy, etc.) ---
# LLM=custom
# CUSTOM_LLM_URL=http://host.docker.internal:8000/v1
# CUSTOM_LLM_API_KEY=
# CUSTOM_MODEL=

# EXTENDED_REASONING=true
# DISABLE_THINKING=true

# =============================================================================
# Slide images
# IMAGE_PROVIDER: gemini_flash | nanobanana_pro | gpt-image-1.5 | openai_compatible
# =============================================================================

# DISABLE_IMAGE_GENERATION=false
# ENABLE_PARALLEL_IMAGE_GENERATION=true
# IMAGE_PROVIDER=gpt-image-1.5

# GPT_IMAGE_1_5_QUALITY=

# OPENAI_COMPAT_IMAGE_BASE_URL=
# OPENAI_COMPAT_IMAGE_API_KEY=
# OPENAI_COMPAT_IMAGE_MODEL=

# =============================================================================
# Mem0 (presentation memory)
# =============================================================================

# MEM0_ENABLED=true
# MEM0_LLM_BASE_URL=https://api.openai.com/v1
# MEM0_LLM_API_KEY=sk-...
# MEM0_LLM_MODEL=gpt-4.1-mini
# MEM0_DIR=/app_data/mem0
# MEM0_EMBEDDER_PROVIDER=openai
# MEM0_EMBEDDER_MODEL=text-embedding-3-small
# MEM0_EMBEDDING_DIMS=1536
# MEM0_SPACY_MODEL=en_core_web_sm
# MEM0_REQUIRE_SPACY_MODEL=true

# =============================================================================
# Document parse / web search
# =============================================================================

# LITEPARSE_DPI=120
# LITEPARSE_NUM_WORKERS=1

# WEB_GROUNDING=true
# WEB_SEARCH_PROVIDER=auto
# auto = OpenAI/Google native search. Custom-LLM SearXNG is a later, separate
# deploy; leave SEARXNG_BASE_URL unset until that service exists.
# WEB_SEARCH_MAX_RESULTS=

# Automatic web image search always needs SearXNG. Keep this false until a
# dedicated search deploy exists.
WEB_IMAGE_SEARCH_ENABLED=false
# WEB_IMAGE_SEARCH_MAX_RESULTS=30
